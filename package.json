{
  "name": "vallet-desktop",
  "version": "1.1.0",
  "private": true,
  "description": "Painel administrativo desktop do Vallet",
  "main": "electron/main.cjs",
  "scripts": {
  "dev": "concurrently -k \"vite\" \"wait-on http://localhost:5173 && electron .\"",
  "start": "npm run dev",
  "vite:build": "vite build",
  "build": "vite build && electron-builder",
  "preview": "vite preview",
  "test": "vite build && node --check electron/main.cjs"
  },
  "build": {
    "appId": "com.vallet.desktop",
    "productName": "Vallet",
    "directories": {
      "output": "dist_electron"
    },
    "win": {
      "icon": "build/valletlogo.ico",
      "target": "nsis"
    },
    "mac": {
      "icon": "build/valletlogo.ico",
      "target": ["dmg"]
    },
    "linux": {
      "icon": "build/valletlogo.ico",
      "target": ["AppImage"]
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"

    ]
  },
  "dependencies": {
    "firebase": "^13.2.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-router-dom": "^7.8.2"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^5.0.2",
    "concurrently": "^9.2.1",
    "electron": "^37.4.0",
    "electron-builder": "^26.18.0",
    "prettier": "^3.9.7",
    "vite": "^7.1.3",
    "wait-on": "^8.0.4"
  }
}
